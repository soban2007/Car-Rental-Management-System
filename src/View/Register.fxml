<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.RegisterController"
           styleClass="root-pane"
           prefWidth="1000"
           prefHeight="650">

    <HBox>

        <!-- ========================= -->
        <!-- LEFT BRAND PANEL          -->
        <!-- ========================= -->

        <VBox prefWidth="400"
              alignment="CENTER"
              spacing="20"
              styleClass="brand-panel">

            <Label text="🚗"
                   styleClass="brand-icon"/>

            <Label text="CAR RENTAL"
                   styleClass="brand-title"/>

            <Label text="Management System"
                   styleClass="brand-subtitle"/>

            <Label text="Create your Administrator Account"
                   wrapText="true"
                   textAlignment="CENTER"
                   styleClass="brand-tagline"/>

        </VBox>

        <!-- ========================= -->
        <!-- RIGHT REGISTER PANEL      -->
        <!-- ========================= -->

        <ScrollPane fitToWidth="true"
                    HBox.hgrow="ALWAYS"
                    style="-fx-background-color:transparent;">

            <VBox alignment="CENTER"
                  styleClass="form-panel">

                <VBox spacing="15"
                      maxWidth="420"
                      styleClass="form-card">

                    <padding>
                        <Insets top="35"
                                right="35"
                                bottom="35"
                                left="35"/>
                    </padding>

                    <Label text="Create Account"
                           styleClass="form-title"/>

                    <Label text="Administrator Registration"
                           styleClass="form-subtitle"/>

                    <!-- Full Name -->

                    <VBox spacing="5">

                        <Label text="Full Name"
                               styleClass="field-label"/>

                        <TextField fx:id="txtFullName"
                                   promptText="Enter Full Name"
                                   styleClass="form-field"/>

                    </VBox>

                    <!-- Email -->

                    <VBox spacing="5">

                        <Label text="Email"
                               styleClass="field-label"/>

                        <TextField fx:id="txtEmail"
                                   promptText="Enter Email"
                                   styleClass="form-field"/>

                    </VBox>

                    <!-- Phone -->

                    <VBox spacing="5">

                        <Label text="Phone Number"
                               styleClass="field-label"/>

                        <TextField fx:id="txtPhone"
                                   promptText="03XXXXXXXXX"
                                   styleClass="form-field"/>

                    </VBox>

                    <!-- Username -->

                    <VBox spacing="5">

                        <Label text="Username"
                               styleClass="field-label"/>

                        <TextField fx:id="txtUsername"
                                   promptText="Choose Username"
                                   styleClass="form-field"/>

                    </VBox>

                    <!-- Password -->

                    <VBox spacing="5">

                        <Label text="Password"
                               styleClass="field-label"/>

                        <PasswordField fx:id="txtPassword"
                                       promptText="Enter Password"
                                       styleClass="form-field"/>

                    </VBox>

                    <!-- Confirm Password -->

                    <VBox spacing="5">

                        <Label text="Confirm Password"
                               styleClass="field-label"/>

                        <PasswordField fx:id="txtConfirmPassword"
                                       promptText="Confirm Password"
                                       styleClass="form-field"/>

                    </VBox>

                    <!-- Register Button -->

                    <Button fx:id="btnRegister"
                            text="CREATE ACCOUNT"
                            maxWidth="Infinity"
                            styleClass="btn-primary"
                            onAction="#handleRegister"/>

                    <!-- Back to Login -->

                    <HBox alignment="CENTER"
                          spacing="5">

                        <Label text="Already have an account?"
                               styleClass="field-label"/>

                        <Hyperlink text="Login"
                                   styleClass="switch-link"
                                   onAction="#goToLogin"/>

                    </HBox>

                </VBox>

            </VBox>

        </ScrollPane>

    </HBox>

</StackPane>