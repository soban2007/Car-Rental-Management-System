<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.LoginController"
           styleClass="root-pane"
           prefWidth="950"
           prefHeight="600">

    <HBox>

        <!-- ========================= -->
        <!-- LEFT BRAND PANEL          -->
        <!-- ========================= -->

        <VBox prefWidth="400"
              alignment="CENTER"
              spacing="20"
              styleClass="brand-panel">

            <Label text="🚗"
                   styleClass="brand-icon"/>

            <Label text="CAR RENTAL"
                   styleClass="brand-title"/>

            <Label text="Management System"
                   styleClass="brand-subtitle"/>

            <Label text="Manage Vehicles • Customers • Rentals • Reports"
                   wrapText="true"
                   textAlignment="CENTER"
                   styleClass="brand-tagline"/>

        </VBox>

        <!-- ========================= -->
        <!-- RIGHT LOGIN PANEL         -->
        <!-- ========================= -->

        <VBox prefWidth="550"
              alignment="CENTER"
              styleClass="form-panel">

            <VBox spacing="18"
                  maxWidth="380"
                  styleClass="form-card">

                <Label text="Welcome Back"
                       styleClass="form-title"/>

                <Label text="Administrator Login"
                       styleClass="form-subtitle"/>

                <!-- Username -->

                <VBox spacing="5">

                    <Label text="Username"
                           styleClass="field-label"/>

                    <TextField fx:id="txtUsername"
                               promptText="Enter Username"
                               styleClass="form-field"/>

                </VBox>

                <!-- Password -->

                <VBox spacing="5">

                    <Label text="Password"
                           styleClass="field-label"/>

                    <PasswordField fx:id="txtPassword"
                                   promptText="Enter Password"
                                   styleClass="form-field"/>

                </VBox>

                <!-- Remember -->

                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <CheckBox
                            text="Remember Me"
                            styleClass="remember-check"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Hyperlink text="Forgot Password?"
                               styleClass="forgot-link"/>

                </HBox>

                <!-- LOGIN BUTTON -->

                <Button fx:id="btnLogin"
                        text="LOGIN"
                        maxWidth="Infinity"
                        styleClass="btn-primary"
                        onAction="#handleLogin"/>

                <!-- Divider -->

                <HBox spacing="10"
                      alignment="CENTER">

                    <Separator HBox.hgrow="ALWAYS"/>

                    <Label text="OR"
                           styleClass="divider-label"/>

                    <Separator HBox.hgrow="ALWAYS"/>

                </HBox>

                <!-- Register -->

                <HBox alignment="CENTER"
                      spacing="5">

                    <Label text="New Administrator?"
                           styleClass="field-label"/>

                    <Hyperlink text="Create Account"
                               onAction="#handleGoToRegister"
                               styleClass="switch-link"/>

                </HBox>

            </VBox>

        </VBox>

    </HBox>

</StackPane>