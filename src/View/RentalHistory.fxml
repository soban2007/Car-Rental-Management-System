<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.RentalHistoryController"
            stylesheets="@../css/dashboard.css"
            prefWidth="1100"
            prefHeight="650">

    <top>

        <VBox spacing="5" style="-fx-padding:20;">

            <Label text="Rental History"
                   styleClass="page-title"/>

            <Label text="View and manage all rental records."
                   styleClass="page-subtitle"/>

        </VBox>

    </top>

    <center>

        <VBox spacing="20" style="-fx-padding:20;">

            <VBox spacing="15" styleClass="chart-card">

                <padding>
                    <Insets top="20"
                            right="20"
                            bottom="20"
                            left="20"/>
                </padding>

                <TableView fx:id="tableRentals"
                           prefHeight="500">

                    <columns>

                        <TableColumn fx:id="colRentalId"
                                     text="Rental ID"
                                     prefWidth="120"/>

                        <TableColumn fx:id="colCustomer"
                                     text="Customer"
                                     prefWidth="180"/>

                        <TableColumn fx:id="colVehicle"
                                     text="Vehicle"
                                     prefWidth="220"/>

                        <TableColumn fx:id="colDays"
                                     text="Days"
                                     prefWidth="80"/>

                        <TableColumn fx:id="colCost"
                                     text="Total Cost"
                                     prefWidth="120"/>

                        <TableColumn fx:id="colReturned"
                                     text="Returned"
                                     prefWidth="120"/>

                    </columns>

                </TableView>

                <HBox spacing="15"
                      alignment="CENTER_RIGHT">

                    <Button text="Refresh"
                            onAction="#handleRefresh"
                            styleClass="logout-button"/>

                    <Button text="Return Vehicle"
                            onAction="#handleReturnVehicle"
                            styleClass="action-button"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>