<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.RentalController"
            stylesheets="@../css/dashboard.css"
            prefWidth="1000"
            prefHeight="650">

    <!-- Header -->

    <top>

        <VBox spacing="5" style="-fx-padding:20;">

            <Label text="Rental Management"
                   styleClass="page-title"/>

            <Label text="Create a new vehicle rental transaction."
                   styleClass="page-subtitle"/>

        </VBox>

    </top>

    <!-- Content -->

    <center>

        <VBox spacing="20"
              style="-fx-padding:20;">

            <VBox spacing="20"
                  styleClass="chart-card">

                <padding>

                    <Insets top="25"
                            right="30"
                            bottom="25"
                            left="30"/>

                </padding>

                <GridPane hgap="20"
                          vgap="18">

                    <columnConstraints>

                        <ColumnConstraints percentWidth="35"/>

                        <ColumnConstraints percentWidth="65"/>

                    </columnConstraints>

                    <!-- Rental ID -->

                    <Label text="Rental ID"/>

                    <TextField fx:id="txtRentalId"
                               GridPane.columnIndex="1"
                               promptText="Enter Rental ID"
                               styleClass="search-field"/>

                    <!-- Customer -->

                    <Label text="Customer"
                           GridPane.rowIndex="1"/>

                    <ComboBox fx:id="comboCustomers"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1"
                              prefWidth="350"/>

                    <!-- Vehicle -->

                    <Label text="Vehicle"
                           GridPane.rowIndex="2"/>

                    <ComboBox fx:id="comboVehicles"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="2"
                              prefWidth="350"
                              onAction="#calculateEstimatedCost"/>

                    <!-- Days -->

                    <Label text="Rental Days"
                           GridPane.rowIndex="3"/>

                    <TextField fx:id="txtDays"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="3"
                               promptText="Enter Number of Days"
                               styleClass="search-field"/>

                    <!-- Cost -->

                    <Label text="Estimated Cost"
                           GridPane.rowIndex="4"/>

                    <Label fx:id="lblCost"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"
                           text="Rs. 0"
                           style="-fx-font-size:18px;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#27ae60;"/>

                </GridPane>

                <Separator/>

                <HBox spacing="15"
                      alignment="CENTER_RIGHT">

                    <Button text="Clear"
                            onAction="#clearForm"
                            styleClass="logout-button"/>

                    <Button text="Rent Vehicle"
                            onAction="#handleRent"
                            styleClass="action-button"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>